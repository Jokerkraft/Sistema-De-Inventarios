<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="420.0" spacing="12.0" style="-fx-background-color: #f8fafc;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cabrera.inventario.controllers.CuentaController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Gestión de Cuenta de Acceso" textFill="#1e3a8a">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <TabPane fx:id="tabPaneCuentas" tabClosingPolicy="UNAVAILABLE">
        <tabs>
            <Tab text="Crear Cuenta">
                <VBox spacing="10.0">
                    <padding>
                        <Insets bottom="12.0" left="8.0" right="8.0" top="15.0" />
                    </padding>
                    <Label text="Nombre completo:" />
                    <TextField fx:id="txtRegNombre" promptText="Ej. María López" />

                    <Label text="Nombre de usuario:" />
                    <TextField fx:id="txtRegUsuario" promptText="Ej. mlopez" />

                    <Label text="Contraseña (mínimo 6 caracteres):" />
                    <PasswordField fx:id="txtRegContrasena" promptText="Nueva contraseña" />

                    <Label text="Confirmar contraseña:" />
                    <PasswordField fx:id="txtRegConfirmar" promptText="Repite la contraseña" />

                    <Button maxWidth="Infinity" onAction="#registrarCuenta"
                            style="-fx-background-color: #1d4ed8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px;"
                            text="Registrar Usuario" />
                </VBox>
            </Tab>

            <Tab text="Recuperar Contraseña">
                <VBox spacing="10.0">
                    <padding>
                        <Insets bottom="12.0" left="8.0" right="8.0" top="15.0" />
                    </padding>
                    <Label text="Usuario registrado:" />
                    <TextField fx:id="txtRecUsuario" promptText="Ingresa tu username" />

                    <Label text="Nombre completo registrado (verificación):" />
                    <TextField fx:id="txtRecNombre" promptText="Debe coincidir con el registro" />

                    <Label text="Nueva contraseña:" />
                    <PasswordField fx:id="txtRecNuevaContrasena" promptText="Nueva contraseña" />

                    <Label text="Confirmar nueva contraseña:" />
                    <PasswordField fx:id="txtRecConfirmar" promptText="Repite la nueva contraseña" />

                    <Button maxWidth="Infinity" onAction="#restablecerContrasena"
                            style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px;"
                            text="Actualizar Contraseña" />
                </VBox>
            </Tab>
        </tabs>
    </TabPane>

    <HBox alignment="CENTER_RIGHT">
        <Button onAction="#cerrarVentana" text="Cerrar" />
    </HBox>
</VBox>