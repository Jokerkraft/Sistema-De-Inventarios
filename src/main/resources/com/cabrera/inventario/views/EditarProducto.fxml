<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="350.0" prefWidth="400.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cabrera.inventario.controllers.EditarProductoController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Editar Producto">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <VBox spacing="5.0">
            <Label text="Código del Producto (No editable):" />
            <TextField fx:id="txtCodigo" disable="true" style="-fx-background-color: #e9ecef;" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Nombre:" />
            <TextField fx:id="txtNombre" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Descripción:" />
            <TextField fx:id="txtDescripcion" promptText="Detalles del producto" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Precio Venta:" />
            <TextField fx:id="txtPrecio" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Stock Actual:" />
            <TextField fx:id="txtStock" />
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <VBox.margin>
                <Insets top="15.0" />
            </VBox.margin>
            <Button mnemonicParsing="false" onAction="#cerrarVentana" text="Cancelar" />
            <Button mnemonicParsing="false" onAction="#guardarCambios" style="-fx-background-color: #ffc107; -fx-font-weight: bold;" text="Guardar Cambios" />
        </HBox>
    </children>
</VBox>