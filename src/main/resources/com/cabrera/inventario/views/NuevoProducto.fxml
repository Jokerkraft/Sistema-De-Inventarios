<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="400.0" prefWidth="400.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cabrera.inventario.controllers.NuevoProductoController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Registrar Nuevo Producto">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <VBox spacing="5.0">
            <Label text="Código del Producto:" />
            <TextField fx:id="txtCodigo" promptText="Ej. PROD-006" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Nombre:" />
            <TextField fx:id="txtNombre" promptText="Nombre del artículo" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Precio Base:" />
            <HBox spacing="10.0">
                <TextField fx:id="txtPrecioBase" promptText="0.00" HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#obtenerPrecioSugerido" style="-fx-background-color: #008C41; -fx-text-fill: white; -fx-font-weight: bold;" text="Sugerir con API" />
            </HBox>
        </VBox>

        <VBox spacing="5.0">
            <Label text="Stock Inicial:" />
            <TextField fx:id="txtStock" promptText="0" />
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <VBox.margin>
                <Insets top="15.0" />
            </VBox.margin>
            <Button mnemonicParsing="false" text="Cancelar" />
            <Button mnemonicParsing="false" onAction="#guardarProducto" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;" text="Guardar Producto" />
        </HBox>
    </children>
</VBox>