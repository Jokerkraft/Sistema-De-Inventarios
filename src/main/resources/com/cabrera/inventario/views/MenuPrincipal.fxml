<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cabrera.inventario.controllers.MenuPrincipalController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="45.0" style="-fx-background-color: #f8f9fa; -fx-border-color: #dcdcdc; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
            <children>
                <MenuBar style="-fx-background-color: transparent;">
                    <menus>
                        <Menu text="Archivo">
                            <items>
                                <MenuItem onAction="#salirDelSistema" text="Salir" />
                            </items>
                        </Menu>
                        <Menu text="Productos">
                            <items>
                                <MenuItem onAction="#abrirVentanaNuevoProducto" text="Nuevo Producto" />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>

                <Region HBox.hgrow="ALWAYS" />

                <Button mnemonicParsing="false" onAction="#cerrarSesion" style="-fx-background-color: #0066FF; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5px;" text="Cerrar Sesión">
                    <HBox.margin>
                        <Insets right="15.0" />
                    </HBox.margin>
                </Button>
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label text="Inventario Actual">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>

                <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colCodigo" prefWidth="120.0" text="Código" />
                        <TableColumn fx:id="colNombre" prefWidth="300.0" text="Nombre del Producto" />
                        <TableColumn fx:id="colDescripcion" prefWidth="200.0" text="Descripción" />
                        <TableColumn fx:id="colPrecio" prefWidth="150.0" text="Precio Venta" />
                        <TableColumn fx:id="colStock" prefWidth="120.0" text="Stock Actual" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#eliminarProducto" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold;" text="Eliminar Selección" />
                        <Button mnemonicParsing="false" onAction="#editarProducto" style="-fx-background-color: #ffc107; -fx-font-weight: bold;" text="Editar Selección" />
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>