<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="520.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom, #eef6ff 0%, #f4f7fb 100%);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cabrera.inventario.controllers.MenuPrincipalController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="12.0" style="-fx-background-color: linear-gradient(to right, #0f172a, #1d4ed8); -fx-border-color: rgba(255,255,255,0.25); -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
            <children>
                <Label text="Inventario" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>

                <Region HBox.hgrow="ALWAYS" />

                <Button mnemonicParsing="false" onAction="#abrirVentanaNuevoProducto" style="-fx-background-color: linear-gradient(to right, #22c55e, #16a34a); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10px; -fx-cursor: hand;" text="Nuevo Producto" />
                <Button mnemonicParsing="false" onAction="#abrirVentanaProveedores" style="-fx-background-color: linear-gradient(to right, #f59e0b, #f97316); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10px; -fx-cursor: hand;" text="Proveedores" />
                <Button mnemonicParsing="false" onAction="#cerrarSesion" style="-fx-background-color: linear-gradient(to right, #10b981, #059669); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10px; -fx-cursor: hand;" text="Cerrar Sesión" />
                <Button mnemonicParsing="false" onAction="#salirDelSistema" style="-fx-background-color: linear-gradient(to right, #ef4444, #dc2626); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10px; -fx-cursor: hand;" text="Salir" />
            </children>
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
        </HBox>
    </top>

    <center>
        <VBox spacing="14.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Label text="Inventario Actual" textFill="#0f172a">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS" style="-fx-background-radius: 12px; -fx-border-color: #dfeafc; -fx-border-radius: 12px;">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colCodigo" prefWidth="120.0" text="Código" />
                        <TableColumn fx:id="colNombre" prefWidth="300.0" text="Nombre del Producto" />
                        <TableColumn fx:id="colDescripcion" prefWidth="200.0" text="Descripción" />
                        <TableColumn fx:id="colPrecio" prefWidth="150.0" text="Precio Venta" />
                        <TableColumn fx:id="colStock" prefWidth="120.0" text="Stock Actual" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#eliminarProducto" style="-fx-background-color: linear-gradient(to right, #ef4444, #dc2626); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10px; -fx-cursor: hand;" text="Eliminar Selección" />
                        <Button mnemonicParsing="false" onAction="#editarProducto" style="-fx-background-color: linear-gradient(to right, #fbbf24, #f59e0b); -fx-text-fill: #111827; -fx-font-weight: bold; -fx-background-radius: 10px; -fx-cursor: hand;" text="Editar Selección" />
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>